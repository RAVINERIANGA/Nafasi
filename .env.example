# Nafasi Firebase Environment Configuration

# 1. Create a project at https://console.firebase.google.com
# 2. Add a Web App and copy your config values here
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourApiKeyHere..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="nafasi-emergency.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="nafasi-emergency"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="nafasi-emergency.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef12345678"

# Backend Firebase Admin SDK (optional for server-side trusted writes)
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@nafasi-emergency.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
